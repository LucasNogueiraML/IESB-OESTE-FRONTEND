generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Settings {
  id             Int @id @default(1)
  workTime       Int
  shortBreakTime Int
  longBreakTime  Int

  @@map("settings")
}

model Task {
  id            String @id
  name          String
  duration      Int
  type          String
  startDate     Int
  completeDate  Int?
  interruptDate Int?

  @@map("tasks")
}
